{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "http": {
      "routePrefix": "api",
      "maxOutstandingRequests": 100,
      "maxConcurrentRequests": 50,
      "dynamicThrottlesEnabled": true
    }
  },
  "logging": {
    "logLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Worker": "Information"
    }
  }
}
